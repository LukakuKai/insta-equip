  "authors": ["LukakuKai"],
  "license": "MIT",
  "environment": "client",
  "mixins": [
    {
      "config": "instantequip.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
